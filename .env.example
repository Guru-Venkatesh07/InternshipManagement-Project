# Internship Management System - Environment Variables

# Backend Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database URL
# Default SQLite for instant out-of-the-box local development:
DATABASE_URL="file:./dev.db"

# Or PostgreSQL for production deployment:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/internship_db?schema=public"

# JWT Secret & Expiry
JWT_SECRET="super-secret-college-internship-mgmt-jwt-key-2026"
JWT_EXPIRES_IN="8h"

# Node Environment
NODE_ENV="development"
